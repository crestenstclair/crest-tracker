{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "crest-synth",
  "version": "0.0.1",
  "identifier": "synth.crest.dev",
  "build": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "crest-projection-page-events",
          "description": "The MIXER projection page listens on crest://projection and crest://meters and echoes crest://painted; no other IPC surface is granted.",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "resources": {
      "assets/licenses/": "licenses/",
      "vendor/azeret-mono/OFL.txt": "licenses/AZERET_MONO.txt",
      "sf2/SGM-V2.01.sf2": "sf2/HiDef.sf2",
      "midi/Radiohead - Everything In Its Right Place - HiDef Compatible.mid": "midi/Radiohead - Everything In Its Right Place - HiDef Compatible.mid"
    }
  }
}
