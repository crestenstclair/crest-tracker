{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crest-synth.local/schema/phase03-review-manifest-v1.json",
  "title": "Crest Synth Phase 03 composition review manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "surface", "figma", "native", "referenceFacts", "nativeFacts", "coordinateEqualityRequired", "pixelDiffRequired"],
  "properties": {
    "schemaVersion": {"const": 1},
    "reviewId": {"type": "string", "minLength": 1},
    "surface": {"type": "string", "minLength": 1},
    "figma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileKey", "nodeId", "retrievedAt", "imagePath", "imageSha256"],
      "properties": {
        "fileKey": {"type": "string", "minLength": 1},
        "nodeId": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
        "retrievedAt": {"type": "string", "minLength": 1},
        "imagePath": {"type": "string", "minLength": 1},
        "imageSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturePath", "observedAt", "windowCondition", "viewportWidthPx", "viewportHeightPx", "deviceScale", "textScale", "fixtureIdentity", "semanticDocumentSha256", "paintAcknowledgement"],
      "properties": {
        "capturePath": {"type": "string", "minLength": 1},
        "observedAt": {"type": "string", "minLength": 1},
        "windowCondition": {"type": "string", "minLength": 1},
        "viewportWidthPx": {"type": "number", "exclusiveMinimum": 0},
        "viewportHeightPx": {"type": "number", "exclusiveMinimum": 0},
        "deviceScale": {"type": "number", "exclusiveMinimum": 0},
        "textScale": {"type": "number", "exclusiveMinimum": 0},
        "fixtureIdentity": {"type": "string", "minLength": 1},
        "semanticDocumentSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "paintAcknowledgement": {
          "type": "object",
          "required": ["generation", "stateHash", "activeSurface", "focusPath"]
        }
      }
    },
    "referenceFacts": {"type": "array", "minItems": 1},
    "nativeFacts": {"type": "array", "minItems": 1},
    "coordinateEqualityRequired": {"const": false},
    "pixelDiffRequired": {"const": false}
  }
}
